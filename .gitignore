# --- PII / private reference material — NEVER commit ---
_private/
*.docx
*.pdf

# --- data / databases ---
data/
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# --- secrets ---
secrets/
.env
.env.*
# the template carries no values — it is meant to be committed
!.env.example
*.local.*
service-account*.json

# --- deps / build ---
node_modules/
dist/
# `build/*`, not `build/` — an ignored DIRECTORY is never descended into, so a `!` negation
# under it does nothing at all and the file below would silently never be committed.
build/*
# …except the embed manifest and its guard, which are SOURCE (plan 0009). The manifest is
# generated but checked in on purpose: `bun install` must not be a prerequisite for
# reading what a binary contains, and build/assets.test.ts is what fails when it is stale.
!build/assets.gen.ts
!build/assets.test.ts
*.log

# --- os / editor ---
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# --- compiled binary output (plan 0007) ---
steward
steward.exe
release/

# nimbalyst session artifacts
.nimbalyst/
nimbalyst-local/
