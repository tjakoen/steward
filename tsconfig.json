{
  "compilerOptions": {
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "types": ["bun-types"],

    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,

    "jsx": "react-jsx"
  },
  "include": ["server.ts", "config.ts", "app/**/*.ts", "frontend/**/*.ts", "shell/**/*.ts"],
  "exclude": ["node_modules", "dist", "_private"]
}
